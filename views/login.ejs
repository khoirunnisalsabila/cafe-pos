<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login | Titik Temu Kopi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: 'DM Sans', sans-serif;
      background: #f5f1e9;
      color: #28372c;
    }
    .login-wrap { min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr; }
    .brand-panel {
      background: #243b2e; color: #fff8ec; padding: 56px;
      display: flex; flex-direction: column; justify-content: space-between;
      position: relative; overflow: hidden;
    }
    .brand-panel:after {
      content: ''; position: absolute; width: 390px; height: 390px;
      border: 1px solid #ffffff24; border-radius: 50%;
      right: -130px; bottom: -120px;
      box-shadow: 0 0 0 35px #ffffff08, 0 0 0 70px #ffffff06;
    }
    .brand-name { font-size: 14px; letter-spacing: 3px; text-transform: uppercase; font-weight: 700; }
    .brand-title { font: 700 clamp(38px, 4vw, 62px)/1.12 'Playfair Display', serif; margin: 24px 0; }
    .brand-desc { color: #d5dfd4; max-width: 370px; line-height: 1.8; }
    .brand-foot { color: #c0cfbf; font-size: 12px; letter-spacing: 1px; }
    .form-panel { display: flex; align-items: center; justify-content: center; padding: 36px; }
    .login-card { width: 100%; max-width: 410px; }
    .eyebrow { color: #8b6a42; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; }
    h2 { font: 700 34px 'Playfair Display', serif; margin: 12px 0; }
    .sub { color: #7c827a; font-size: 14px; margin-bottom: 30px; }
    .form-label { font-size: 13px; font-weight: 600; margin-bottom: 8px; }
    .form-control { padding: 13px 14px; border: 1px solid #dedbd1; border-radius: 10px; background: #fffdf8; }
    .form-control:focus { border-color: #45634c; box-shadow: 0 0 0 3px #45634c1c; }
    .btn-login { width: 100%; border: 0; border-radius: 10px; padding: 14px; background: #294633; color: white; font-weight: 700; margin-top: 10px; }
    .btn-login:hover { background: #1e3526; color: white; }
    .error-box { border-radius: 9px; font-size: 13px; }
    @media(max-width: 760px) {
      .login-wrap { grid-template-columns: 1fr; }
      .brand-panel { padding: 28px; min-height: 240px; }
      .brand-title { font-size: 38px; margin: 12px 0; }
      .brand-desc { font-size: 13px; }
      .brand-foot { margin-top: 26px; }
      .form-panel { padding: 34px 24px; }
    }
  </style>
</head>
<body>
  <main class="login-wrap">
    <section class="brand-panel">
      <div class="brand-name">TTK · Titik Temu Kopi</div>
      <div>
        <div class="eyebrow" style="color:#d8bd91">Coffee · People · Moments</div>
        <div class="brand-title">Every cup<br>has a story.</div>
        <p class="brand-desc">Sistem pengelolaan kafe untuk transaksi yang lebih mudah, operasional yang tertata, dan pelayanan yang hangat.</p>
      </div>
      <div class="brand-foot">CAFE MANAGEMENT SYSTEM · 2026</div>
    </section>

    <section class="form-panel">
      <div class="login-card">
        <div class="eyebrow">Welcome back</div>
        <h2>Selamat datang.</h2>
        <p class="sub">Masuk ke akun Anda untuk melanjutkan.</p>

        <% if (error) { %>
          <div class="alert alert-danger error-box"><%= error %></div>
        <% } %>

        <form action="/login" method="POST">
          <div class="mb-3">
            <label class="form-label" for="username">Username</label>
            <input class="form-control" id="username" name="username" type="text" placeholder="Masukkan username" autocomplete="username" required autofocus>
          </div>
          <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <input class="form-control" id="password" name="password" type="password" placeholder="Masukkan password" autocomplete="current-password" required>
          </div>
          <button class="btn btn-login" type="submit">Masuk ke Dashboard &rarr;</button>
        </form>
        <p class="text-center mt-4 mb-0" style="font-size:12px;color:#92958b">Akses khusus staf Titik Temu Kopi</p>
      </div>
    </section>
  </main>
</body>
</html>
