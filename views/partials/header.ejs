
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Dashboard' %> | Titik Temu Kopi</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    .sidebar {
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow-y: auto;
      overflow-x: hidden;
      padding-top: 18px;
      padding-bottom: 8px;
    }

    .brand {
      padding-bottom: 20px;
      flex-shrink: 0;
    }

    .sidebar .nav-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 12px;
      flex-shrink: 0;
    }

    .sidebar .nav-label {
      padding-top: 6px;
      padding-bottom: 6px;
    }

    .sidebar .nav-label.mt-4 {
      margin-top: 12px !important;
    }

    .sidebar-bottom {
      margin-top: auto;
      padding-top: 10px;
      padding-bottom: 4px;
      flex-shrink: 0;
      border-top: 1px solid #ffffff1a;
    }

    .user-chip {
      padding: 4px 8px;
    }

    .sidebar .logout-link {
      display: flex !important;
      align-items: center;
      justify-content: flex-start;
      gap: 10px;
      width: 100%;
      min-height: 38px;
      padding: 8px 12px !important;
      margin-top: 4px !important;
      border-radius: 9px;
      border: 1px solid #ffffff30;
      background: #ffffff12;
      color: #ffffff !important;
      font-size: 13px !important;
      text-decoration: none;
      white-space: nowrap;
    }

    .sidebar .logout-link:hover {
      background: #ffffff25;
      color: #ffffff !important;
    }

    .sidebar .logout-link i {
      display: inline-block !important;
      font-size: 17px !important;
      flex-shrink: 0;
    }

    @media (max-width: 900px) {
      .sidebar {
        width: 76px;
        padding: 16px 8px 8px;
      }

      .brand {
        justify-content: center;
        padding: 0 0 20px;
      }

      .brand > span:last-child,
      .sidebar .nav-label {
        display: none;
      }

      .sidebar .nav-link:not(.logout-link) {
        justify-content: center;
        padding: 12px 6px;
        font-size: 0;
      }

      .sidebar .nav-link i {
        font-size: 19px;
      }

      .sidebar-bottom .user-info {
        display: none;
      }

      .user-chip {
        justify-content: center;
        padding: 4px 0;
      }

      .sidebar .logout-link {
        flex-direction: column;
        justify-content: center;
        gap: 3px;
        padding: 7px 2px !important;
        font-size: 10px !important;
        white-space: normal;
      }

      .sidebar .logout-link i {
        font-size: 18px !important;
      }
    }
  </style>
</head>

<body>
<div class="app-shell">
  <aside class="sidebar">

    <a class="brand" href="<%= user.role === 'admin' ? '/dashboard' : '/pos' %>">
      <span class="brand-icon">
        <i class="bi bi-cup-hot-fill"></i>
      </span>
      <span>
        <strong>Titik Temu</strong>
        <small>COFFEE MANAGEMENT</small>
      </span>
    </a>

    <div class="nav-label">MENU UTAMA</div>

    <% if (user.role === 'admin') { %>
      <a class="nav-link <%= title === 'Dashboard' ? 'active' : '' %>" href="/dashboard">
        <i class="bi bi-grid-1x2"></i>
        Dashboard
      </a>

      <div class="nav-label mt-4">MANAJEMEN</div>

      <a class="nav-link <%= title === 'Produk & Stok' ? 'active' : '' %>" href="/products">
        <i class="bi bi-cup-straw"></i>
        Produk &amp; Stok
      </a>

      <a class="nav-link <%= title === 'Pengguna' ? 'active' : '' %>" href="/users">
        <i class="bi bi-people"></i>
        Pengguna
      </a>

      <a class="nav-link <%= title === 'Laporan' ? 'active' : '' %>" href="/reports">
        <i class="bi bi-bar-chart"></i>
        Laporan
      </a>
    <% } %>

    <% if (user.role === 'kasir') { %>
      <a class="nav-link <%= title === 'Transaksi POS' ? 'active' : '' %>" href="/pos">
        <i class="bi bi-bag-plus"></i>
        Transaksi POS
      </a>

        <a class="nav-link <%= title === 'Riwayat Transaksi' ? 'active' : '' %>" href="/riwayat-transaksi">
         <i class="bi bi-clock-history"></i>
         Riwayat Transaksi
        </a>
    <% } %>

    <div class="sidebar-bottom">
      <div class="user-chip">
        <div class="avatar">
          <%= (user.nama_lengkap || user.username).charAt(0).toUpperCase() %>
        </div>

        <div class="user-info">
          <strong><%= user.nama_lengkap || user.username %></strong>
          <small>
            <%= user.role === 'admin' ? 'Administrator Utama' : 'Kasir / Waiter' %>
          </small>
        </div>
      </div>

      <a class="nav-link logout-link" href="/logout">
        <i class="bi bi-box-arrow-left"></i>
        <span>Logout</span>
      </a>
    </div>

  </aside>

  <main class="main-content">
    <header class="topbar">
      <div>
        <div class="topbar-kicker">TITIK TEMU KOPI / OPERASIONAL</div>
        <h1><%= title || 'Dashboard' %></h1>
      </div>

      <div class="topbar-date">
        <i class="bi bi-calendar3"></i>
        <%= new Date().toLocaleDateString('id-ID', {
          day: 'numeric',
          month: 'long',
          year: 'numeric'
        }) %>
      </div>
    </header>
