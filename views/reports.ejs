<%- include('partials/header', { title, user }) %>

<%
  const rupiah = value => 'Rp ' + Number(value || 0).toLocaleString('id-ID');
  const dateTime = value => new Date(value).toLocaleString('id-ID', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
  const queryString = new URLSearchParams({
    start: filters.start,
    end: filters.end,
    category: filters.category,
    payment: filters.payment
  }).toString();
%>

<style>
  .report-page { padding: 24px; }
  .report-title { color: #4b3024; font-weight: 700; }
  .report-card { background: #fff; border: 1px solid #eadfd5; border-radius: 14px; padding: 20px; height: 100%; }
  .report-label { color: #817168; font-size: 13px; margin-bottom: 8px; }
  .report-value { color: #4b3024; font-size: 22px; font-weight: 700; overflow-wrap: anywhere; }
  .report-filter { background: #fff; border: 1px solid #eadfd5; border-radius: 14px; padding: 20px; }
  .btn-coffee { background: #6f4e37; border-color: #6f4e37; color: #fff; }
  .btn-coffee:hover { background: #563b2a; border-color: #563b2a; color: #fff; }
  .report-table th { background: #f5eee8; color: #4b3024; white-space: nowrap; font-size: 13px; }
  .report-table td { vertical-align: middle; font-size: 13px; }
  .report-table-wrap { overflow-x: auto; }
  .report-status { display: inline-block; border-radius: 20px; padding: 5px 10px; font-size: 12px; background: #f3eee9; color: #5b4638; }
  @media print {
    .sidebar, .report-filter, .report-actions, .navbar, header nav, footer { display: none !important; }
    .report-page { padding: 0; }
    .report-card { break-inside: avoid; }
    body { background: #fff !important; }
  }
</style>

<div class="report-page">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
      <h2 class="report-title mb-1">Laporan Penjualan</h2>
      <p class="text-muted mb-0">Rekap historis dan analisis transaksi Titik Temu Kopi</p>
    </div>
    <div class="d-flex gap-2 flex-wrap report-actions">
      <a href="/reports/export.csv?<%= queryString %>" class="btn btn-coffee">
        Ekspor CSV
      </a>
      <a href="/reports/export.pdf?<%= queryString %>" class="btn btn-outline-secondary">
        Ekspor PDF
      </a>
      <button type="button" onclick="window.print()" class="btn btn-outline-secondary">
        Cetak
      </button>
    </div>
  </div>

  <form action="/reports" method="GET" class="report-filter mb-4">
    <div class="row g-3 align-items-end">
      <div class="col-md-3">
        <label for="start" class="form-label">Dari Tanggal</label>
        <input type="date" id="start" name="start" class="form-control" value="<%= filters.start %>" required>
      </div>
      <div class="col-md-3">
        <label for="end" class="form-label">Sampai Tanggal</label>
        <input type="date" id="end" name="end" class="form-control" value="<%= filters.end %>" required>
      </div>
      <div class="col-md-2">
        <label for="category" class="form-label">Kategori Menu</label>
        <select id="category" name="category" class="form-select">
          <option value="">Semua Kategori</option>
          <% categories.forEach(category => { %>
            <option value="<%= category.id %>" <%= String(filters.category) === String(category.id) ? 'selected' : '' %>>
              <%= category.nama_kategori %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label for="payment" class="form-label">Metode Pembayaran</label>
        <select id="payment" name="payment" class="form-select">
          <option value="">Semua Metode</option>
          <% payments.forEach(payment => { %>
            <option value="<%= payment.metode_bayar %>" <%= filters.payment === payment.metode_bayar ? 'selected' : '' %>>
              <%= payment.metode_bayar %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-coffee flex-grow-1">Filter</button>
        <a href="/reports" class="btn btn-outline-secondary">Reset</a>
      </div>
    </div>
  </form>

  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl">
      <div class="report-card">
        <div class="report-label">Total Omzet</div>
        <div class="report-value"><%= rupiah(summary.total_omzet) %></div>
      </div>
    </div>
    <div class="col-sm-6 col-xl">
      <div class="report-card">
        <div class="report-label">Total Diskon</div>
        <div class="report-value"><%= rupiah(summary.total_diskon) %></div>
      </div>
    </div>
    <div class="col-sm-6 col-xl">
      <div class="report-card">
        <div class="report-label">Total Pajak</div>
        <div class="report-value"><%= rupiah(summary.total_pajak) %></div>
      </div>
    </div>
    <div class="col-sm-6 col-xl">
      <div class="report-card">
        <div class="report-label">Omzet Bersih</div>
        <div class="report-value"><%= rupiah(Number(summary.total_omzet) - Number(summary.total_pajak)) %></div>
      </div>
    </div>
    <div class="col-sm-6 col-xl">
      <div class="report-card">
        <div class="report-label">Rata-rata Transaksi</div>
        <div class="report-value"><%= rupiah(summary.rata_rata) %></div>
      </div>
    </div>
  </div>

  <div class="report-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <div>
        <h5 class="report-title mb-1">Detail Transaksi</h5>
        <div class="text-muted small">
          Periode <%= filters.start %> sampai <%= filters.end %>
        </div>
      </div>
      <span class="badge text-bg-light"><%= rows.length %> transaksi</span>
    </div>

    <div class="report-table-wrap">
      <table class="table table-hover report-table mb-0">
        <thead>
          <tr>
            <th>No. Faktur</th>
            <th>Tanggal & Jam</th>
            <th>Kasir</th>
            <th>Tipe Pesanan</th>
            <th>Item Terjual</th>
            <th>Pajak</th>
            <th>Grand Total</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (rows.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center text-muted py-5">
                Tidak ada transaksi untuk filter yang dipilih.
              </td>
            </tr>
          <% } else { %>
            <% rows.forEach(row => { %>
              <tr>
                <td class="fw-semibold"><%= row.invoice_number %></td>
                <td><%= dateTime(row.created_at) %></td>
                <td><%= row.kasir || '-' %></td>
                <td><%= row.tipe_pesanan %></td>
                <td><%= row.item_terjual %></td>
                <td><%= rupiah(row.pajak_nominal) %></td>
                <td class="fw-semibold"><%= rupiah(row.grand_total) %></td>
                <td><span class="report-status"><%= row.status %></span></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
